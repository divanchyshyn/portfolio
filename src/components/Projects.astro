---
import { projects } from '../data/cv';
---

<section class="section" id="projects">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <p class="section-intro">Things I build outside of work hours — usually to try a technology properly before recommending it.</p>
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <ul class="project-tech" aria-label={`Technologies used in ${project.name}`}>
            {project.tech.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
          <div class="project-links">
            <a href={project.url}>Visit site<span class="visually-hidden">: {project.name}</span></a>
            {project.sourceUrl && (
              <a href={project.sourceUrl}>Source<span class="visually-hidden">: {project.name}</span></a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  h3 {
    font-size: 1.125rem;
  }

  .project-card > p {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-top: 0.5rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.1rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }
</style>