---
import { Picture } from 'astro:assets';
import { profile } from '../data/cv';
import profilePic from '../assets/profile.jpg';
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="hero-eyebrow">{profile.location}</p>
      <h1>{profile.name}</h1>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-lede">
        13 years of building cloud-native backend platforms — event-driven .NET,
        Azure and Kubernetes, with agentic AI woven into how the work gets done.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">Get in touch</a>
        <a class="btn btn-ghost" href={profile.linkedin}>LinkedIn profile</a>
      </div>
    </div>
    <div class="hero-photo-frame">
      <Picture
        src={profilePic}
        alt="Dmytro Ivanchyshyn hiking in the mountains"
        formats={['avif', 'webp']}
        widths={[360, 540, 720]}
        sizes="(max-width: 899px) 90vw, 420px"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-eyebrow {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.5vw, 3.4rem);
    margin-bottom: 0.4rem;
  }

  .hero-role {
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .hero-lede {
    max-width: 55ch;
    margin-bottom: 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-photo-frame {
    display: grid;
    justify-self: center;
    width: min(100%, 420px);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
    background: var(--surface);
  }

  .hero-photo-frame :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 899px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-text {
      order: 1;
    }

    .hero-photo-frame {
      order: 0;
      width: min(100%, 320px);
    }
  }
</style>