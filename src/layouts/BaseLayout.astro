---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/cv';
import faviconUrl from '../assets/favicon.svg?url';
import ogImageUrl from '../assets/og.jpg?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.description,
} = Astro.props;

const fallbackSite = 'https://divanchyshyn.com';
const canonical = new URL(Astro.url.pathname, Astro.site ?? fallbackSite);
const ogImage = new URL(ogImageUrl, Astro.site ?? fallbackSite);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: profile.description,
  url: canonical.href,
  image: ogImage.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Oslo', addressCountry: 'NO' },
  sameAs: [profile.linkedin, profile.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Theme bootstrap: runs before first paint so the correct theme applies
      without a flash. Dark is the default; an explicit visitor choice wins
      over the OS preference. The toggle handler lives in Header.astro and
      must keep this contract: localStorage key `theme`, values `light` |
      `dark`, stored on `document.documentElement.dataset.theme`.
    -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>